# AI model. Gemini (free tier) is the default: key from aistudio.google.com.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optional: AI_PROVIDER=claude to use Claude instead, with APP_ANTHROPIC_API_KEY.
AI_PROVIDER=
APP_ANTHROPIC_API_KEY=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty, or set PAYPAL_MODE=mock, to run against the built-in simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app, needed to receive dispute webhooks.
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=
# Production servers show the live sandbox view-only, since all visitors share it. Set to 1 to allow actions.
LIVE_SANDBOX_WRITABLE=

# Optional: AG Grid Enterprise license (row grouping and master-detail on Insights).
AG_GRID_LICENSE_KEY=

# Where saved investigations live (default cache/investigations).
REBUTTAL_CACHE_DIR=

# Development only: replay a scripted model instead of calling the AI.
REBUTTAL_SCRIPTED_MODEL=

# Seller accounts (optional; without these the app runs the demo only).
# Postgres connection string. On Render the blueprint links its database automatically.
DATABASE_URL=
# Set to 1 when connecting to Postgres over an external URL that needs TLS.
DATABASE_SSL=
# Encrypts sellers' PayPal secrets. Generate with: openssl rand -base64 32
# Keep it: changing it means every seller has to connect PayPal again.
REBUTTAL_SECRET_KEY=
# Public https address of this app, used to register sellers' PayPal webhooks
# (Render sets RENDER_EXTERNAL_URL, which is used when this is empty).
APP_URL=
# Optional: AG Grid Enterprise licence key. Never commit it.
AG_GRID_LICENSE_KEY=
